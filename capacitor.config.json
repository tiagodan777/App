{
  "appId": "com.margot.app",
  "appName": "Margot",
  "webDir": "www",
  "server": {
    "url": "https://margot-app.com",
    "cleartext": false
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": []
    },
    "Keyboard": {
      "resize": "none",
      "autoBackdropColor": "dom"
    },
    "SplashScreen": {
      "launchShowDuration": 900,
      "launchAutoHide": true,
      "launchFadeOutDuration": 250,
      "backgroundColor": "#FFFFFFFF",
      "showSpinner": false
    }
  }
}