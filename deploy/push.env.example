# Copiar para /etc/margot/push.env no servidor com root:root e modo 600.
# A chave APNs deve ficar root:www-data e modo 640, porque o worker corre
# como www-data. Nunca colocar chaves APNs/FCM no Git.

MARGOT_PUSH_ENABLED=true

# Apple Push Notification service
MARGOT_APNS_ENVIRONMENT=production
MARGOT_APNS_TEAM_ID=XXXXXXXXXX
MARGOT_APNS_KEY_ID=XXXXXXXXXX
MARGOT_APNS_PRIVATE_KEY_FILE=/etc/margot/AuthKey_XXXXXXXXXX.p8
MARGOT_APNS_TOPIC=com.margot.app

# Firebase Cloud Messaging HTTP v1 (necessário apenas para Android)
MARGOT_FCM_SERVICE_ACCOUNT_FILE=/etc/margot/firebase-service-account.json
MARGOT_FCM_PROJECT_ID=margot-app
