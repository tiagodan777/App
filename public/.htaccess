RewriteEngine On
RewriteBase /

# A imagem genérica não contém dados pessoais e continua a ser um asset público.
RewriteRule ^imagens/fotos-perfil/default\.webp$ - [L,NC]

# Fotografias e anexos reais só podem ser servidos por endpoints autenticados.
RewriteRule ^imagens/fotos-perfil(?:-originais|-temp)?(?:/|$) - [F,L,NC]
RewriteRule ^media/mensagens(?:/|$) - [F,L,NC]

# se pedirem /index.php diretamente, manda para /
RewriteCond %{THE_REQUEST} \s/index\.php[?\s] [NC]
RewriteRule ^index\.php$ / [R=301,L]

# tudo o que não for ficheiro/pasta real vai para index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L]

# segurança básica
Options -Indexes
Header always set X-Frame-Options "DENY"
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "no-referrer"

# Dumps, configuração e ficheiros temporários nunca devem ser publicados.
<FilesMatch "\.(sql|sqlite|sqlite3|log|env|ini|bak)$">
    Require all denied
</FilesMatch>
